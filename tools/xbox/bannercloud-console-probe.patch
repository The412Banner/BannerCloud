+            Ok(_) => eprintln!("NEXUS_SESSION_DIAGNOSTIC_V1 console-device-token-issued"),
+            Err(_) => eprintln!("NEXUS_SESSION_DIAGNOSTIC_V1 console-device-token-denied"),
