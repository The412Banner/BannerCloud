+/// BannerCloud console test: ask device.auth for a device token that self-declares DeviceType "Xbox",
+/// signed with a locally generated key (no console hardware). Returns the XBL device token, else the error.
+pub async fn probe_console_device_token() -> Result<String, String> {
+    let mut auth = XalAuthenticator::new(
+        get_app_params(),
+        xal::XalClientParameters {
+            user_agent: "XAL GRTS 2024.02.20240220.000".to_string(),
+            device_type: DeviceType::Custom("Xbox".to_string()),
+            client_version: "10.0.22621.4196".to_string(),
+            query_display: "none".to_string(),
+        },
+        "RETAIL".to_owned(),
+    );
+    match auth.get_device_token().await {
+        Ok(token) => Ok(token.token),
+        Err(error) => Err(format!("{error}")),
+    }
+}
